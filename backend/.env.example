# Backend environment template for AITutor
# Copy this file to backend/.env and replace placeholder values.
# Keep .env out of version control.

# ---------------------------------------------------------------------------
# Core app + auth (required)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5430/aitutordb
SECRET_KEY=replace_with_a_long_random_secret
ADMIN_REGISTRATION_KEY=replace_with_admin_registration_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------------
# Plan + rate limits (optional; defaults shown)
# ---------------------------------------------------------------------------
PREMIUM_TRIAL_DAYS=1
FREE_DAILY_COURSE_LIMIT=1
FREE_DAILY_LESSON_LIMIT=2

# ---------------------------------------------------------------------------
# LLM provider selection
# Supported values: bedrock | openai-compatible
# ---------------------------------------------------------------------------
LLM_PROVIDER=bedrock
LLM_TEMPERATURE=0.1

# ---------------------------------------------------------------------------
# AWS Bedrock settings (required when LLM_PROVIDER=bedrock)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=us-east-1
# Optional fallback region var used by some AWS SDK setups:
# AWS_DEFAULT_REGION=us-east-1

# Bedrock model ID or inference profile ID
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Example ARN form:
# BEDROCK_MODEL_ID=arn:aws:bedrock:ap-south-1:123456789012:inference-profile/global.anthropic.claude-sonnet-4-6

# ---------------------------------------------------------------------------
# OpenAI-compatible settings (required when LLM_PROVIDER=openai-compatible)
# ---------------------------------------------------------------------------
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL_ID=minimax/minimax-m2.5

# Preferred key variable used by app:
OPENAI_COMPAT_API_KEY=replace_me

# Optional alternatives (app will use first non-empty key in this order:
# OPENAI_COMPAT_API_KEY -> OPEN_ROUTER_API_KEY -> OPENAI_API_KEY)
# OPEN_ROUTER_API_KEY=replace_me
# OPENAI_API_KEY=replace_me

# ---------------------------------------------------------------------------
# Optional local model testing
# ---------------------------------------------------------------------------
# OLLAMA_MODEL_NAME=glm-4.7-flash:latest
